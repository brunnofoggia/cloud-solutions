{
    "name": "cloud-solutions",
    "version": "4.2.0",
    "description": "",
    "license": "ISC",
    "author": "Bruno Foggia",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "scripts": {
        "husky:install": "husky install",
        "exec:kms": "cross-env IS_TS_NODE=true ts-node -r tsconfig-paths/register test/kms",
        "prebuild": "rimraf dist",
        "build": "tsc -p ./tsconfig.build.json",
        "lint": "eslint \"{src,apps,libs}/**/*.+(js|json|ts|tsx)\" --fix",
        "pre-commit": "lint-staged && yarn build",
        "prepare": "npm run build",
        "testx": "jest --verbose --maxWorkers=3",
        "testy": "jest --verbose",
        "test": "npx jest --detectOpenHandles --runInBand",
        "test:clear": "npx jest --clearCache",
        "coverage": "npx jest --coverage --runInBand"
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.891.0",
        "@aws-sdk/client-sqs": "^3.891.0",
        "@aws-sdk/client-ssm": "^3.891.0",
        "@aws-sdk/lib-storage": "^3.891.0",
        "@aws-sdk/util-stream": "^3.374.0",
        "@commitlint/config-conventional": "^19.8.1",
        "@google-cloud/secret-manager": "^6.1.0",
        "@google-cloud/storage": "^7.17.1",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/node": "^24.5.1",
        "@typescript-eslint/eslint-plugin": "^7.9.0",
        "@typescript-eslint/parser": "^7.9.0",
        "amqplib": "^0.10.9",
        "aws-sdk": "^2.1692.0",
        "commitlint": "^19.8.1",
        "cross-env": "^10.0.0",
        "cz-conventional-changelog": "^3.3.0",
        "dotenv": "^17.2.2",
        "eslint": "^8.57.1",
        "eslint-plugin-promise": "^7.2.1",
        "eslint-plugin-security": "^3.0.1",
        "git-commit-msg-linter": "^5.0.8",
        "husky": "^9.1.7",
        "jest": "^30.1.3",
        "lint-staged": "^16.1.6",
        "rimraf": "^6.0.1",
        "ssh2-sftp-client": "^12.0.1",
        "ts-jest": "^29.4.2",
        "ts-loader": "^9.5.4",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "api-link-aio": "^0.4.6",
        "debug": "^4.4.3",
        "jsonwebtoken": "^9.0.2",
        "lodash": "^4.17.21"
    },
    "files": [
        "/dist"
    ],
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}